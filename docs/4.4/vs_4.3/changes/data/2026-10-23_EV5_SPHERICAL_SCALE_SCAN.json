    "sha256": "ea82c29a048e6b15bb0762c940f983b9a9902fa9b82c5ba8745fa670421f56c2",
    "utf8_source": "\"\"\"Reproduce the limited objective scan after safe affine preprocessing.\"\"\"\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport sys\nimport time\nfrom datetime import datetime, timezone\nimport numpy as np\n\nROOT = Path(__file__).resolve().parents[2]\nsys.path.insert(0, str(ROOT))\nfrom inversion.src.spherical_response import _ResponseScore, DEGREES\n\nstarted = time.perf_counter()\nfrozen = json.loads((ROOT/'docs/4.3/vs_4.2/experiments/data/2026-10-20_EV5_PRECISION_MODELS.json').read_text(encoding='utf8'))\ncases = []\nfor tag, maximum in [('70m', 14400), ('400m', 28800)]:\n    with np.load(ROOT/f'tmp/ev5_precision_solution_20261020/geometry/{tag}_inputs.npz') as source:\n        t, y, phase, z, ids = [source[k] for k in ('times', 'features', 'phase', 'z', 'runs')]\n    groups = np.array([np.flatnonzero(ids == group) for group in np.unique(ids)])\n    references = frozen['results'][f'geometry/{tag}_full500_all_train.json']['data']['results']\n    by_degree = []\n    for degree in DEGREES:\n        golden = next(entry['top10'][0] for entry in references if entry['degree'] == degree)\n        frequencies = np.r_[np.linspace(1/maximum, 1/1800., 17), 1/golden['period_s']]\n        baseline = _ResponseScore(t, y, phase, z, groups, degree)\n        old = [baseline.evaluate(f, True) for f in frequencies]\n        rows = []\n        for multiplier in (1., 1e-200, 1e200):\n            scaled = y*multiplier\n            normalized = scaled/np.max(abs(scaled), axis=0)\n            normalized -= normalized.mean(axis=0)\n            normalized /= normalized.std(axis=0)\n            scorer = _ResponseScore(t, normalized, phase, z, groups, degree)\n            new = [scorer.evaluate(f, True) for f in frequencies]\n            difference = max(abs(a['score']-b['score']) for a, b in zip(old, new))\n            alpha_mismatches = sum(a['alpha_by_feature'] != b['alpha_by_feature'] for a, b in zip(old, new))\n            assert difference < 1e-8, (tag, degree, multiplier, difference)\n            assert new[-1]['alpha_by_feature'] == golden['alpha_by_feature']\n            assert abs(new[-1]['score']-golden['cv_mean']) < 1e-8\n            rows.append(dict(multiplier=multiplier, max_score_difference=difference,\n                             alpha_mismatch_frequency_count=alpha_mismatches,\n                             golden_frequency_score_difference=new[-1]['score']-golden['cv_mean']))\n        by_degree.append(dict(degree=degree, frequencies_hz=frequencies.tolist(), scale_rows=rows))\n    cases.append(dict(case=tag, degree_results=by_degree))\nmodule = ROOT/'inversion/src/spherical_response.py'\nrecord = dict(measured_utc=datetime.now(timezone.utc).isoformat(), elapsed_s=time.perf_counter()-started,\n    baseline_source_sha256='88529e144da2df558c128d6cb949a3830f46c501c5011be589fdeb5066d09770',\n    current_source_sha256=hashlib.sha256(module.read_bytes()).hexdigest(),\n    change='Pass the already safely normalized channels to _ResponseScore instead of original y.',\n    scope='Objective scan only: 17 frequencies over full domain plus each degree frozen optimum, all 5 degrees, two clean inputs, 3 scales. Full search belongs to baseline source evidence.',\n    command='conda run --no-capture-output -n pytorch python tmp/ev5_production_acceptance/spherical_scale_scan.py',\n    environment={k: os.environ.get(k) for k in ['OMP_NUM_THREADS', 'MKL_NUM_THREADS', 'OPENBLAS_NUM_THREADS']},\n    cases=cases)\n(ROOT/'tmp/ev5_production_acceptance/spherical_scale_scan.json').write_text(json.dumps(record, indent=2), encoding='utf8')\nprint(record['current_source_sha256'], record['elapsed_s'])\n"
  }
